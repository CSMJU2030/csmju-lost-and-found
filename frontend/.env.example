# คัดลอกเป็น .env.local ถ้าค่าเครื่องคุณต่างจากนี้
# backend ที่หน้าเว็บส่งต่อ /api /uploads และ /auth/callback ไปให้ (ดู next.config.js, src/app/auth/)
BACKEND_URL=http://localhost:4000
# เว็บของ Core Hub (เริ่ม SSO ที่ <ค่านี้>/api/sso/<SUBSYSTEM_ID>)
CORE_HUB_WEB_URL=http://localhost:3100
SUBSYSTEM_ID=csmju-lost-and-found
