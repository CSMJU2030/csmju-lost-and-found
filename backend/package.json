{
  "name": "backend",
  "version": "1.0.0",
  "description": "Lost & Found (CSMJU2030 subsystem csmju-lost-and-found) - NestJS API ที่ใช้ตัวตนจาก Core Hub (RS256 + JWKS)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "postinstall": "prisma generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "generate:openapi": "nest build && node dist/src/scripts/generate-openapi.js",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config jest-e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "prisma:studio": "prisma studio",
    "prisma:import-legacy": "ts-node src/scripts/import-legacy.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.1",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "prisma": "7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9",
    "typescript-eslint": "^8.20.0"
  }
}
