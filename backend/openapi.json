  "info": {
    "title": "Lost & Found API",
    "description": "ระบบย่อย csmju-lost-and-found ของ CSMJU2030 · ทุก response ห่อด้วย { success, data, meta? } หรือ { success: false, error: { code, message, details? } } · ยืนยันตัวตนด้วย Core Hub access token",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "core_hub_access_token"
      }
    },
    "schemas": {
      "MemberView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "studentId": {
            "type": "string",
            "description": "รหัสนักศึกษา (ถ้ามี)"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "สำเนาสิทธิ์ที่แมปจาก core role: admin = เจ้าหน้าที่",
            "enum": [
              "admin",
              "user"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "studentId",
          "fullName",
          "email",
          "phone",
          "role",
          "createdAt"
        ]
      },
      "ItemView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "รหัสที่แสดงให้ผู้ใช้ เช่น LF-2026-00001"
          },
          "reportType": {
            "enum": [
              "lost",
              "found"
            ],
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "faculty": {
            "type": "string"
          },
          "building": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "dateLost": {
            "type": "string",
            "description": "วันที่ของหาย/พบของ (YYYY-MM-DD)"
          },
          "timeLost": {
            "type": "string",
            "description": "เวลาโดยประมาณ (HH:MM เวลาไทย)"
          },
          "status": {
            "enum": [
              "found",
              "searching",
              "returned"
            ],
            "type": "string"
          },
          "urgency": {
            "enum": [
              "normal",
              "high"
            ],
            "type": "string"
          },
          "imageUrl": {
            "type": "string",
            "description": "รูปหลัก (path /uploads/...) หรือค่าว่าง"
          },
          "thumbnails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pinX": {
            "type": "number"
          },
          "pinY": {
            "type": "number"
          },
          "secretQuestion": {
            "type": "string"
          },
          "secretAnswer": {
            "type": "string",
            "description": "ส่งให้เฉพาะเจ้าของโพสต์และเจ้าหน้าที่"
          },
          "reporterId": {
            "type": "string",
            "description": "id ใน members ของผู้แจ้ง"
          },
          "reporterName": {
            "type": "string"
          },
          "reporterStudentId": {
            "type": "string"
          },
          "reporterPhone": {
            "type": "string"
          },
          "reporterContact": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "activeClaims": {
            "type": "number",
            "description": "จำนวนคำขอที่ยังดำเนินการอยู่"
          }
        },
        "required": [
          "id",
          "code",
          "reportType",
          "name",
          "description",
          "category",
          "location",
          "faculty",
          "building",
          "room",
          "dateLost",
          "timeLost",
          "status",
          "urgency",
          "imageUrl",
          "thumbnails",
          "reporterId",
          "reporterName",
          "reporterStudentId",
          "reporterPhone",
          "reporterContact",
          "createdAt",
          "activeClaims"
        ]
      },
      "MatchView": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/components/schemas/ItemView"
          },
          "score": {
            "type": "number",
            "description": "0-100"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "item",
          "score",
          "reasons"
        ]
      },
      "CreateItemDto": {
        "type": "object",
        "properties": {
          "reportType": {
            "type": "string",
            "enum": [
              "lost",
              "found"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "maxLength": 50
          },
          "location": {
            "type": "string",
            "maxLength": 300
          },
          "faculty": {
            "type": "string",
            "maxLength": 100
          },
          "building": {
            "type": "string",
            "maxLength": 100
          },
          "room": {
            "type": "string",
            "maxLength": 50
          },
          "dateLost": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "timeLost": {
            "type": "string",
            "description": "HH:MM"
          },
          "urgency": {
            "type": "string",
            "enum": [
              "normal",
              "high"
            ]
          },
          "images": {
            "description": "รูปแบบ data URL (JPG/PNG/WEBP ไม่เกิน 2 MB ต่อรูป) หรือ path /uploads/... ที่อัปโหลดไว้แล้ว",
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 3000000
            }
          },
          "pinX": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "pinY": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "secretQuestion": {
            "type": "string",
            "maxLength": 150
          },
          "secretAnswer": {
            "type": "string",
            "maxLength": 100
          },
          "reporterName": {
            "type": "string",
            "maxLength": 80
          },
          "reporterStudentId": {
            "type": "string",
            "description": "รหัสนักศึกษา 10 หลัก (ไม่บังคับ)"
          },
          "reporterPhone": {
            "type": "string"
          },
          "reporterContact": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "reportType",
          "name",
          "description",
          "category",
          "location",
          "room",
          "dateLost",
          "timeLost",
          "reporterName",
          "reporterPhone",
          "reporterContact"
        ]
      },
      "UpdateItemDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "searching",
              "found",
              "returned"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "DeletedView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "deleted"
        ]
      },
      "CreateClaimDto": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string",
            "maxLength": 50
          },
          "lastName": {
            "type": "string",
            "maxLength": 50
          },
          "studentId": {
            "type": "string",
            "description": "รหัสนักศึกษา 10 หลัก (ไม่บังคับ)"
          },
          "department": {
            "type": "string",
            "maxLength": 80
          },
          "meetDate": {
            "type": "string",
            "description": "วันที่นัด YYYY-MM-DD (เวลาไทย)"
          },
          "meetTime": {
            "type": "string",
            "description": "เวลานัด HH:MM (เวลาไทย)"
          },
          "meetLocation": {
            "type": "string",
            "maxLength": 100
          },
          "contact": {
            "type": "string",
            "maxLength": 50
          },
          "note": {
            "type": "string",
