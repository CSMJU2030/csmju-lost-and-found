# ---------------------------------------------------------------------------
# Lost & Found (ระบบย่อย csmju-lost-and-found) — คัดลอกเป็น .env แล้วแก้ค่า · ห้าม commit .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4220

# ---- ฐานข้อมูลของระบบนี้เอง (ห้ามชี้ไปฐานข้อมูลของ Core Hub) ----------------
# ใช้ชุดเดียวกับ docker-compose.yml (และ DBeaver)
POSTGRES_USER=lostfound
POSTGRES_PASSWORD=lostfound
POSTGRES_DB=lost_and_found_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lostfound:lostfound@localhost:5432/lost_and_found_db
# ฐานข้อมูลของชุดทดสอบ e2e (ไม่ตั้ง = ใช้ lost_and_found_test_db บนเซิร์ฟเวอร์เดียวกัน)
# TEST_DATABASE_URL=
# ฐานข้อมูลเดิมก่อนย้ายมาใช้ Prisma (ใช้กับ pnpm --filter backend prisma:import-legacy เท่านั้น)
LEGACY_DATABASE_URL=postgresql://lostfound:lostfound@localhost:5432/lostfound

# โฟลเดอร์เก็บรูปที่อัปโหลด
UPLOAD_DIR=uploads

# ---- Core Hub (ผู้ออก token) -----------------------------------------------
CORE_HUB_URL=http://localhost:3000
# กุญแจสาธารณะ (public เท่านั้น — ห้ามมี private key ในระบบนี้)
CORE_HUB_JWKS_URL=http://localhost:3000/api/v1/.well-known/jwks.json
# สัญญา JWT (ห้ามเปลี่ยน)
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5

# ชื่อระบบ — ต้องตรงกับ subsystem.yaml และทะเบียนใน Core Hub
SUBSYSTEM_ID=csmju-lost-and-found
SUBSYSTEM_NAME=Lost & Found

# ---- Central SSO (auth-contract 1.0) ---------------------------------------
# Core Hub ส่งเบราว์เซอร์มาที่ <ที่อยู่ frontend>/auth/callback (callback_url ในทะเบียน)
# backend ตรวจ token แล้วตั้งคุกกี้ core_hub_access_token (HttpOnly) — ดู AUTH_INTEGRATION.md

# ---- Database pool ---------------------------------------------------------
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000
